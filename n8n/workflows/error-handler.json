{
  "name": "Herald - System Error Handler",
  "nodes": [
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://herald-api:8000/api/v1/ops/error-handler",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.HERALD_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"job_id\": \"{{$json.execution.error.job_id || null}}\",\n  \"error_code\": \"{{$json.execution.error.message || 'WORKFLOW_EXECUTION_ERROR'}}\",\n  \"error_detail\": \"{{$json.execution.error.description || 'Execution failure in n8n workflow'}}\"\n}",
        "options": {}
      },
      "name": "Call Herald Error Handler API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Call Herald Error Handler API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
