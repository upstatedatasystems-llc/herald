{
  "name": "Herald - Audio Completion & Delivery Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "Schedule Trigger - 1 Min Poll",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://herald-api:8000/api/v1/delivery/claim",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Claim Delivery Job (Atomic)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.claimed }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check If Job Claimed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        750,
        300
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $json.job.local_audio_path }}",
        "options": {}
      },
      "name": "Read Local MP3 File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        1000,
        250
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "upload",
        "fileContentKey": "data",
        "name": "={{ JSON.parse($('Claim Delivery Job (Atomic)').item.json.job.script_json).episode_title }}.mp3",
        "parents": [
          "={{ $env.GOOGLE_DRIVE_FOLDER_ID }}"
        ],
        "options": {}
      },
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1250,
        250
      ],
      "credentials": {
        "googleDriveOAuth2": {
          "id": "1",
          "name": "Herald Google Drive Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/drive-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"drive_file_id\": \"{{ $json.id }}\",\n  \"drive_web_link\": \"{{ $json.webViewLink }}\"\n}",
        "options": {}
      },
      "name": "Record Drive Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1500,
        250
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $('Claim Delivery Job (Atomic)').item.json.job.audio_bytes / 1024 / 1024 }}",
              "operation": "smallerEqual",
              "value2": "={{ Number($env.EMAIL_ATTACHMENT_MAX_MB || 18) }}"
            }
          ]
        }
      },
      "name": "Check Attachment Threshold",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1750,
        250
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "reply",
        "messageId": "={{ $('Claim Delivery Job (Atomic)').item.json.job.gmail_message_id }}",
        "message": "=Your Herald podcast episode is ready!\n\nTitle: {{ JSON.parse($('Claim Delivery Job (Atomic)').item.json.job.script_json).episode_title }}\nDuration: {{ Math.floor($('Claim Delivery Job (Atomic)').item.json.job.audio_duration_seconds / 60) }}m {{ $('Claim Delivery Job (Atomic)').item.json.job.audio_duration_seconds % 60 }}s\nFile Size: {{ ($('Claim Delivery Job (Atomic)').item.json.job.audio_bytes / 1024 / 1024).toFixed(2) }} MB\n\nGoogle Drive Link:\n{{ $json.drive_web_link }}\n\nJob ID: {{ $('Claim Delivery Job (Atomic)').item.json.job.id }}\nAttachment: Included MP3 file",
        "binaryData": true,
        "binaryPropertyName": "data",
        "options": {}
      },
      "name": "Send Reply With Attachment",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2000,
        150
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "1",
          "name": "Herald Gmail Account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "reply",
        "messageId": "={{ $('Claim Delivery Job (Atomic)').item.json.job.gmail_message_id }}",
        "message": "=Your Herald podcast episode is ready!\n\nTitle: {{ JSON.parse($('Claim Delivery Job (Atomic)').item.json.job.script_json).episode_title }}\nDuration: {{ Math.floor($('Claim Delivery Job (Atomic)').item.json.job.audio_duration_seconds / 60) }}m {{ $('Claim Delivery Job (Atomic)').item.json.job.audio_duration_seconds % 60 }}s\nFile Size: {{ ($('Claim Delivery Job (Atomic)').item.json.job.audio_bytes / 1024 / 1024).toFixed(2) }} MB\n\nGoogle Drive Link:\n{{ $json.drive_web_link }}\n\nJob ID: {{ $('Claim Delivery Job (Atomic)').item.json.job.id }}\nAttachment: Link-only reply (file exceeds attachment size limit)",
        "options": {}
      },
      "name": "Send Link-Only Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2000,
        350
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "1",
          "name": "Herald Gmail Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/delivery-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Record Delivery Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        2250,
        250
      ]
    }
  ],
  "connections": {
    "Schedule Trigger - 1 Min Poll": {
      "main": [
        [
          {
            "node": "Claim Delivery Job (Atomic)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Delivery Job (Atomic)": {
      "main": [
        [
          {
            "node": "Check If Job Claimed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check If Job Claimed": {
      "main": [
        [
          {
            "node": "Read Local MP3 File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Local MP3 File": {
      "main": [
        [
          {
            "node": "Upload to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to Google Drive": {
      "main": [
        [
          {
            "node": "Record Drive Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Drive Metadata": {
      "main": [
        [
          {
            "node": "Check Attachment Threshold",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Attachment Threshold": {
      "main": [
        [
          {
            "node": "Send Reply With Attachment",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Link-Only Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Reply With Attachment": {
      "main": [
        [
          {
            "node": "Record Delivery Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Link-Only Reply": {
      "main": [
        [
          {
            "node": "Record Delivery Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "Herald - System Error Handler"
  }
}
