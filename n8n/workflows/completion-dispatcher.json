{
  "name": "Herald - Audio Completion & Delivery Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "Schedule Trigger - 1 Min Poll",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "herald-audio-ready",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Trigger - Audio Ready Nudge",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        200,
        460
      ],
      "webhookId": "herald-audio-ready-nudge"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ ($headers['x-api-key'] || $headers['x-herald-delivery-token']) === ($env.DELIVERY_NUDGE_SECRET || $env.HERALD_API_KEY) }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Validate Nudge Header Auth",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        320,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://herald-api:8000/api/v1/delivery/claim",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Claim Delivery Job (Atomic)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.claimed }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check If Job Claimed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $('Claim Delivery Job (Atomic)').item.json.job.needs_audio_upload }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Needs Audio Upload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        880,
        250
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $('Claim Delivery Job (Atomic)').item.json.job.local_audio_path }}",
        "options": {}
      },
      "name": "Read Local MP3 File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        1080,
        150
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "upload",
        "fileContentKey": "data",
        "name": "={{ $('Claim Delivery Job (Atomic)').item.json.job.audio_filename }}",
        "parents": [
          "={{ $env.GOOGLE_DRIVE_FOLDER_ID }}"
        ],
        "options": {}
      },
      "name": "Upload Audio to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1280,
        150
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "1",
          "name": "Herald Google Drive Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/drive-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"artifact_type\": \"audio\",\n  \"drive_file_id\": \"{{ $json.id }}\",\n  \"drive_web_link\": \"{{ $json.webViewLink }}\",\n  \"drive_job_key\": \"{{ $('Claim Delivery Job (Atomic)').item.json.job.drive_job_key }}\"\n}",
        "options": {}
      },
      "name": "Record Audio Drive Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1480,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $('Claim Delivery Job (Atomic)').item.json.job.needs_details_upload }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Needs Details Upload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1680,
        250
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $('Claim Delivery Job (Atomic)').item.json.job.local_details_path }}",
        "options": {}
      },
      "name": "Read Local Details MD File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        1880,
        150
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "upload",
        "fileContentKey": "data",
        "name": "={{ $('Claim Delivery Job (Atomic)').item.json.job.details_filename }}",
        "parents": [
          "={{ $env.GOOGLE_DRIVE_FOLDER_ID }}"
        ],
        "options": {}
      },
      "name": "Upload Details to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        2080,
        150
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "1",
          "name": "Herald Google Drive Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/drive-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"artifact_type\": \"details\",\n  \"details_drive_file_id\": \"{{ $json.id }}\",\n  \"details_drive_web_link\": \"{{ $json.webViewLink }}\"\n}",
        "options": {}
      },
      "name": "Record Details Drive Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        2280,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $('Claim Delivery Job (Atomic)').item.json.job.needs_email }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Needs Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2480,
        250
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/completion-email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Final Completion Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        2680,
        150
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "reply",
        "messageId": "={{ $('Claim Delivery Job (Atomic)').item.json.job.gmail_message_id }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "name": "Send Link-Only Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2880,
        150
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "1",
          "name": "Herald Gmail Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/delivery-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"gmail_result_message_id\": \"{{ $json.id || '' }}\"\n}",
        "options": {}
      },
      "name": "Record Delivery Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        3080,
        250
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $('Claim Delivery Job (Atomic)').item.json.job.local_details_path }}",
        "options": {}
      },
      "name": "Read Final Details MD File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        3280,
        250
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "update",
        "fileId": "={{ $('Claim Delivery Job (Atomic)').item.json.job.details_drive_file_id || $('Record Details Drive Metadata').item.json.details_drive_file_id || $('Upload Details to Google Drive').item.json.id }}",
        "fileContentKey": "data",
        "options": {}
      },
      "name": "Update Details in Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        3480,
        250
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "1",
          "name": "Herald Google Drive Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/details-finalized",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"details_drive_file_id\": \"{{ $('Claim Delivery Job (Atomic)').item.json.job.details_drive_file_id || $('Record Details Drive Metadata').item.json.details_drive_file_id || $('Upload Details to Google Drive').item.json.id }}\",\n  \"details_drive_web_link\": \"{{ $('Claim Delivery Job (Atomic)').item.json.job.details_drive_web_link || $('Record Details Drive Metadata').item.json.details_drive_web_link || $('Upload Details to Google Drive').item.json.webViewLink }}\"\n}",
        "options": {}
      },
      "name": "Record Details Finalized",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        3680,
        250
      ]
    }
  ],
  "connections": {
    "Schedule Trigger - 1 Min Poll": {
      "main": [
        [
          {
            "node": "Claim Delivery Job (Atomic)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Trigger - Audio Ready Nudge": {
      "main": [
        [
          {
            "node": "Validate Nudge Header Auth",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Nudge Header Auth": {
      "main": [
        [
          {
            "node": "Claim Delivery Job (Atomic)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Delivery Job (Atomic)": {
      "main": [
        [
          {
            "node": "Check If Job Claimed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check If Job Claimed": {
      "main": [
        [
          {
            "node": "Check Needs Audio Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Needs Audio Upload": {
      "main": [
        [
          {
            "node": "Read Local MP3 File",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Check Needs Details Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Local MP3 File": {
      "main": [
        [
          {
            "node": "Upload Audio to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Audio to Google Drive": {
      "main": [
        [
          {
            "node": "Record Audio Drive Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Audio Drive Metadata": {
      "main": [
        [
          {
            "node": "Check Needs Details Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Needs Details Upload": {
      "main": [
        [
          {
            "node": "Read Local Details MD File",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Check Needs Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Local Details MD File": {
      "main": [
        [
          {
            "node": "Upload Details to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Details to Google Drive": {
      "main": [
        [
          {
            "node": "Record Details Drive Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Details Drive Metadata": {
      "main": [
        [
          {
            "node": "Check Needs Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Needs Email": {
      "main": [
        [
          {
            "node": "Fetch Final Completion Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Final Completion Email": {
      "main": [
        [
          {
            "node": "Send Link-Only Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Link-Only Reply": {
      "main": [
        [
          {
            "node": "Record Delivery Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Delivery Complete": {
      "main": [
        [
          {
            "node": "Read Final Details MD File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Final Details MD File": {
      "main": [
        [
          {
            "node": "Update Details in Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Details in Google Drive": {
      "main": [
        [
          {
            "node": "Record Details Finalized",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "Herald - System Error Handler"
  }
}
