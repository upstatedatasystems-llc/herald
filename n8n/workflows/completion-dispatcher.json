{
  "name": "Herald - Audio Completion & Delivery Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "Schedule Trigger - 1 Min Poll",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://herald-api:8000/api/v1/delivery/claim",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Claim Delivery Job (Atomic)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.claimed }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check If Job Claimed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $('Claim Delivery Job (Atomic)').item.json.job.needs_audio_upload }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Needs Audio Upload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        860,
        250
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $('Claim Delivery Job (Atomic)').item.json.job.local_audio_path }}",
        "options": {}
      },
      "name": "Read Local MP3 File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        1080,
        150
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "upload",
        "fileContentKey": "data",
        "name": "={{ $('Claim Delivery Job (Atomic)').item.json.job.audio_filename }}",
        "parents": [
          "={{ $env.GOOGLE_DRIVE_FOLDER_ID }}"
        ],
        "options": {}
      },
      "name": "Upload Audio to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1300,
        150
      ],
      "credentials": {
        "googleDriveOAuth2": {
          "id": "1",
          "name": "Herald Google Drive Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/drive-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"artifact_type\": \"audio\",\n  \"drive_file_id\": \"{{ $json.id }}\",\n  \"drive_web_link\": \"{{ $json.webViewLink }}\",\n  \"drive_job_key\": \"{{ $('Claim Delivery Job (Atomic)').item.json.job.drive_job_key }}\"\n}",
        "options": {}
      },
      "name": "Record Audio Drive Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1520,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $('Claim Delivery Job (Atomic)').item.json.job.needs_source_upload }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Needs Source Upload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1740,
        250
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $('Claim Delivery Job (Atomic)').item.json.job.local_source_path }}",
        "options": {}
      },
      "name": "Read Local Source TXT File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        1960,
        150
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "upload",
        "fileContentKey": "data",
        "name": "={{ $('Claim Delivery Job (Atomic)').item.json.job.source_filename }}",
        "parents": [
          "={{ $env.GOOGLE_DRIVE_FOLDER_ID }}"
        ],
        "options": {}
      },
      "name": "Upload Source to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        2180,
        150
      ],
      "credentials": {
        "googleDriveOAuth2": {
          "id": "1",
          "name": "Herald Google Drive Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/drive-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"artifact_type\": \"source\",\n  \"source_drive_file_id\": \"{{ $json.id }}\",\n  \"source_drive_web_link\": \"{{ $json.webViewLink }}\"\n}",
        "options": {}
      },
      "name": "Record Source Drive Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        2400,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $('Claim Delivery Job (Atomic)').item.json.job.needs_diagnostics_upload }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Needs Diagnostics Upload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2620,
        250
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $('Claim Delivery Job (Atomic)').item.json.job.local_diagnostics_path }}",
        "options": {}
      },
      "name": "Read Local Diagnostics JSON File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        2840,
        150
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "upload",
        "fileContentKey": "data",
        "name": "={{ $('Claim Delivery Job (Atomic)').item.json.job.diagnostics_filename }}",
        "parents": [
          "={{ $env.GOOGLE_DRIVE_FOLDER_ID }}"
        ],
        "options": {}
      },
      "name": "Upload Diagnostics to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        3060,
        150
      ],
      "credentials": {
        "googleDriveOAuth2": {
          "id": "1",
          "name": "Herald Google Drive Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/drive-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"artifact_type\": \"diagnostics\",\n  \"diagnostics_drive_file_id\": \"{{ $json.id }}\",\n  \"diagnostics_drive_web_link\": \"{{ $json.webViewLink }}\"\n}",
        "options": {}
      },
      "name": "Record Diagnostics Drive Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        3280,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $('Claim Delivery Job (Atomic)').item.json.job.needs_email }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Needs Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        3500,
        250
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/completion-email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Final Completion Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        3720,
        150
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "reply",
        "messageId": "={{ $('Claim Delivery Job (Atomic)').item.json.job.gmail_message_id }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "name": "Send Link-Only Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        3940,
        150
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "1",
          "name": "Herald Gmail Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://herald-api:8000/api/v1/jobs/{{ $('Claim Delivery Job (Atomic)').item.json.job.id }}/delivery-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.HERALD_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"gmail_result_message_id\": \"{{ $json.id || '' }}\"\n}",
        "options": {}
      },
      "name": "Record Delivery Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        4160,
        250
      ]
    }
  ],
  "connections": {
    "Schedule Trigger - 1 Min Poll": {
      "main": [
        [
          {
            "node": "Claim Delivery Job (Atomic)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Delivery Job (Atomic)": {
      "main": [
        [
          {
            "node": "Check If Job Claimed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check If Job Claimed": {
      "main": [
        [
          {
            "node": "Check Needs Audio Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Needs Audio Upload": {
      "main": [
        [
          {
            "node": "Read Local MP3 File",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Check Needs Source Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Local MP3 File": {
      "main": [
        [
          {
            "node": "Upload Audio to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Audio to Google Drive": {
      "main": [
        [
          {
            "node": "Record Audio Drive Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Audio Drive Metadata": {
      "main": [
        [
          {
            "node": "Check Needs Source Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Needs Source Upload": {
      "main": [
        [
          {
            "node": "Read Local Source TXT File",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Check Needs Diagnostics Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Local Source TXT File": {
      "main": [
        [
          {
            "node": "Upload Source to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Source to Google Drive": {
      "main": [
        [
          {
            "node": "Record Source Drive Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Source Drive Metadata": {
      "main": [
        [
          {
            "node": "Check Needs Diagnostics Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Needs Diagnostics Upload": {
      "main": [
        [
          {
            "node": "Read Local Diagnostics JSON File",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Check Needs Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Local Diagnostics JSON File": {
      "main": [
        [
          {
            "node": "Upload Diagnostics to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Diagnostics to Google Drive": {
      "main": [
        [
          {
            "node": "Record Diagnostics Drive Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Diagnostics Drive Metadata": {
      "main": [
        [
          {
            "node": "Check Needs Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Needs Email": {
      "main": [
        [
          {
            "node": "Fetch Final Completion Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record Delivery Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Final Completion Email": {
      "main": [
        [
          {
            "node": "Send Link-Only Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Link-Only Reply": {
      "main": [
        [
          {
            "node": "Record Delivery Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "Herald - System Error Handler"
  }
}
