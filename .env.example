# ==============================================================================
# Herald Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE TELEGRAM INTERFACE & AI SCRIPTING
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-from-botfather"

# Multi-Provider Failover Chain (Server Fallbacks)
AI_PROVIDER="gemini"                                # Primary provider: "gemini", "groq", "cloudflare", "openai", "openrouter", "mistral", "anthropic", "ollama", "literal"
AI_SECONDARY_PROVIDER=""                            # Optional Secondary provider for deterministic failover
AI_TERTIARY_PROVIDER=""                             # Optional Tertiary provider for deterministic failover
RESEARCH_PROVIDER="gemini"                          # Dedicated research provider (Gemini required for Google Search Grounding)
AI_PROVIDER_TIMEOUT_SECONDS=300                     # Provider-neutral timeout (defaults to 300s; takes precedence over legacy GEMINI_TIMEOUT_SECONDS)

# Provider Credentials & Models
GEMINI_API_KEY=""                                   # Required for Gemini scripting / research
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_RESEARCH_MODEL="gemini-3.6-flash"
GEMINI_SCRIPT_MAX_OUTPUT_TOKENS=16384                 # Token ceiling for podcast script generation (16384 default)
GEMINI_RESEARCH_NORMALIZATION_INITIAL_OUTPUT_TOKENS=8192 # Initial token budget for research normalization
GEMINI_RESEARCH_NORMALIZATION_MAX_OUTPUT_TOKENS=16384    # Hard ceiling for research normalization tokens
GEMINI_URL_CONTEXT_INITIAL_OUTPUT_TOKENS=8192            # Initial token budget for Gemini URL Context extraction
GEMINI_URL_CONTEXT_MAX_OUTPUT_TOKENS=16384               # Hard ceiling for Gemini URL Context extraction tokens

GROQ_API_KEY=""                                     # Required if using Groq
GROQ_MODEL="llama-3.3-70b-versatile"

OPENAI_API_KEY=""                                   # Required if using OpenAI
OPENAI_MODEL="gpt-4o"

OPENROUTER_API_KEY=""                               # Required if using OpenRouter
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

MISTRAL_API_KEY=""                                  # Required if using Mistral
MISTRAL_MODEL="mistral-large-latest"

CLOUDFLARE_API_TOKEN=""                             # Required if using Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

ANTHROPIC_API_KEY=""                                # Required if using Anthropic
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

OLLAMA_BASE_URL=""                                  # Required if using local Ollama (e.g. "http://localhost:11434")
OLLAMA_MODEL="llama3.1"

# Large-Source Bounded Adaptation
ADAPTATION_MAX_CHUNKS=12                            # Max semantic chunks before rejecting payload
ADAPTATION_MAX_DEPTH=2                              # Max hierarchical reduction passes
ADAPTATION_MAX_AI_CALLS=15                          # Hard limit on AI calls during multi-stage adaptation
ADAPTATION_MAX_ELAPSED_SECONDS=600.0                # Total adaptation time budget in seconds
ADAPTATION_CHUNK_MAX_CHARS=4000                     # Target character ceiling per semantic chunk

TELEGRAM_MAX_AUDIO_BYTES=52428800                   # 50 MB limit for Telegram bot uploads

# Kokoro Speech & Voice Preferences
KOKORO_VOICE="af_heart"                             # "af_heart", "af_bella", "af_sarah", "am_adam", "am_michael"
KOKORO_SPEED=1.0                                    # 0.8 to 1.2
ALLOWED_VOICES="af_heart,af_bella,af_sarah,am_adam,am_michael"

# ------------------------------------------------------------------------------
# 2. SYSTEM & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
TZ="America/New_York"
HERALD_ENV="production"
HERALD_WORK_DIR="/data/herald"
HERALD_MIN_DISK_MB=500
HERALD_LOG_DIR="logs"                               # Canonical logs directory (mapped to host ./logs)
HERALD_CONCURRENCY_PROFILE="auto"                   # "auto", "single", "balanced"
DIAGNOSTICS_MAX_BYTES=8388608                       # 8 MB diagnostics bundle ceiling
DIAGNOSTICS_RETENTION_DAYS=30                       # Retention period in days for terminal diagnostics archives

POSTGRES_DB="herald"
POSTGRES_USER="herald"
POSTGRES_PASSWORD="change-this-to-a-secure-random-db-password"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
HERALD_API_KEY="change-this-to-a-secure-random-api-key"

# Kokoro TTS Service (Local CPU container)
KOKORO_BASE_URL="http://kokoro:8880/v1"
KOKORO_HEALTH_GRACE_SECONDS=120
KOKORO_SYNTHESIS_TIMEOUT_SECONDS=180

# External DNS resolvers used by Herald containers.
# Override these if your environment requires different public/corporate resolvers.
HERALD_DNS_PRIMARY="1.1.1.1"
HERALD_DNS_SECONDARY="8.8.8.8"

# ------------------------------------------------------------------------------
# 3. OPTIONAL LEGACY PROFILE (Gmail, Google Drive, n8n)
# ------------------------------------------------------------------------------
ENABLE_EMAIL_TRANSPORT=false
N8N_ENCRYPTION_KEY="change-this-to-a-32-char-random-key"
GOOGLE_DRIVE_FOLDER_ID=""
EMAIL_ALLOWED_SENDERS="authorized@example.com"
LOCAL_COMPLETE_RETENTION_HOURS=48
