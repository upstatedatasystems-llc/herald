# ==============================================================================
# Herald Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE TELEGRAM INTERFACE (Default)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-from-botfather"
AI_PROVIDER="none"                                # "none" for Literal reading, or "gemini"
# GEMINI_API_KEY="your-gemini-api-key"             # Required only if AI_PROVIDER="gemini"
GEMINI_MODEL="gemini-3.5-flash"
TELEGRAM_MAX_AUDIO_BYTES=52428800                 # 50 MB limit for Telegram bot uploads

# Kokoro Speech & Voice Preferences
KOKORO_VOICE="af_heart"                           # "af_heart", "af_bella", "af_sarah", "am_adam", "am_michael"
KOKORO_SPEED=1.0                                  # 0.8 to 1.2
ALLOWED_VOICES="af_heart,af_bella,af_sarah,am_adam,am_michael"

# ------------------------------------------------------------------------------
# 2. SYSTEM & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
TZ="America/New_York"
HERALD_ENV="production"
HERALD_WORK_DIR="/data/herald"
HERALD_MIN_DISK_MB=500
HERALD_CONCURRENCY_PROFILE="auto"                 # "auto", "single", "balanced"

POSTGRES_DB="herald"
POSTGRES_USER="herald"
POSTGRES_PASSWORD="change-this-to-a-secure-random-db-password"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
HERALD_API_KEY="change-this-to-a-secure-random-api-key"

# Kokoro TTS Service (Local CPU container)
KOKORO_BASE_URL="http://kokoro:8880/v1"
KOKORO_HEALTH_GRACE_SECONDS=120
KOKORO_SYNTHESIS_TIMEOUT_SECONDS=180

# ------------------------------------------------------------------------------
# 3. OPTIONAL LEGACY PROFILE (Gmail, Google Drive, n8n)
# ------------------------------------------------------------------------------
# These variables are only used if starting the legacy n8n/email profile
# via `docker compose --profile legacy up -d`
ENABLE_EMAIL_TRANSPORT=false
N8N_ENCRYPTION_KEY="change-this-to-a-32-char-random-key"
GOOGLE_DRIVE_FOLDER_ID=""
EMAIL_ALLOWED_SENDERS="authorized@example.com"
LOCAL_COMPLETE_RETENTION_HOURS=48
