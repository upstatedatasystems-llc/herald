# Herald Email-to-Podcast Automation System Configuration

# System & Timezone
TZ=America/New_York
HERALD_ENV=production
LOG_LEVEL=INFO

# Herald API & Security
HERALD_API_PORT=8000
HERALD_API_KEY=change-this-to-a-secure-random-api-key
HERALD_MAX_SOURCE_CHARS=100000
HERALD_WORK_DIR=/data/herald

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=herald
POSTGRES_USER=herald
POSTGRES_PASSWORD=change-this-to-a-secure-db-password
DATABASE_URL=postgresql://herald:change-this-to-a-secure-db-password@postgres:5432/herald

# n8n Orchestration
N8N_ENCRYPTION_KEY=change-this-to-a-32-char-random-key
N8N_CONCURRENCY_PRODUCTION_LIMIT=1
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_PORT=5678

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=60
GEMINI_RETRY_COUNT=3

# Kokoro TTS Service
KOKORO_BASE_URL=http://kokoro:8880/v1
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_MODEL_PATH=/opt/herald/models/kokoro
KOKORO_HEALTH_GRACE_SECONDS=120
KOKORO_SYNTHESIS_TIMEOUT_SECONDS=180
MAX_ACTIVE_TTS_JOBS=1
TTS_MAX_CHUNK_CHARS=500

# ETA Calculation
TTS_ESTIMATED_REALTIME_FACTOR=2.5
DELIVERY_ESTIMATED_OVERHEAD_SECONDS=60

# Audio & FFmpeg
AUDIO_OUTPUT_BITRATE=64k
AUDIO_SAMPLE_RATE=24000
AUDIO_CHANNELS=1
LOUDNORM_TARGET_I=-16
LOUDNORM_TARGET_TP=-1.5
LOUDNORM_TARGET_LRA=11

# Google Drive Delivery
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id-here

# Gmail Intake & Delivery
EMAIL_ALLOWED_SENDERS=authorized_user@example.com,podcast_admin@example.com
LOCAL_COMPLETE_RETENTION_HOURS=48
